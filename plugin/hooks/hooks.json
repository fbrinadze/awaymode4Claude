{
  "description": "Away Mode: while away, send questions to Teams, make sure finished work is reported, alert on API errors, and end away mode when you type at the terminal.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*__set_away",
        "hooks": [{ "type": "command", "command": "${user_config.bun_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.ts"], "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "${user_config.bun_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.ts"], "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "${user_config.bun_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.ts"], "timeout": 10 }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "${user_config.bun_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.ts"], "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "${user_config.bun_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/hook.ts"], "timeout": 10 }]
      }
    ]
  }
}
